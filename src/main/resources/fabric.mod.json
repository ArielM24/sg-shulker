{
	"schemaVersion": 1,
	"id": "sg-shulkerbox",
	"version": "${version}",
	"name": "SG Shulkerbox",
	"description": "A mod to show a preview of the content of a shulker with a customizable keybind",
	"authors": [
		"ArielM24"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/sg-shulkerbox/sg-shulker.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.sg.shulkerbox.SGShulkerbox"
		],
		"client": [
			"com.sg.shulkerbox.SGShulkerboxClient"
		]
	},
	"mixins": [
		"sg-shulkerbox.mixins.json",
		{
			"config": "sg-shulkerbox.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.16.14",
		"minecraft": "~1.21.7",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"another-mod": "*"
	}
}